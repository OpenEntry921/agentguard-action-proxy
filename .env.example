XRPL_TESTNET_URL=https://s.altnet.rippletest.net:51234  # XRPL 테스트넷 JSON-RPC 엔드포인트 URL
XRPL_TESTNET_SEED=  # 테스트넷/데모 모드용 seed (절대 실제 값 커밋 금지)
XRPL_MAINNET_SEED=  # live submit 모드 우선 seed (운영 환경에서만 사용)
XRPL_SEED=  # live submit 모드 fallback seed
XRPL_RLUSD_ISSUER=  # RLUSD 발행자(issuer) 주소 사용 시 입력
XRPL_ISSUED_CURRENCY_ISSUER=  # issued currency 발행자 주소 (멀티 자산 테스트용)
USE_XRPL_SUBMIT=false  # true면 테스트넷 제출 시도, false면 로컬/드라이런 모드
XRPL_NETWORK=testnet  # testnet 또는 mainnet (기본 testnet)
