{
  "policyVersion": "1.1.0",
  "scannerVersion": "1.0.0",
  "limits": {
    "maxPromptLength": 20000,
    "maxFileBytes": 10485760
  },
  "supportedFiles": {
    ".txt": [
      "text/plain"
    ],
    ".pdf": [
      "application/pdf"
    ],
    ".docx": [
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/zip"
    ]
  },
  "rules": [
    {
      "id": "private_key_block",
      "matchTypes": [
        "PRIVATE_KEY"
      ],
      "decision": "BLOCK",
      "riskScore": 95
    },
    {
      "id": "credential_block",
      "matchTypes": [
        "API_KEY",
        "ACCESS_TOKEN",
        "BEARER_TOKEN",
        "JWT",
        "PASSWORD_SECRET",
        "CLOUD_CREDENTIAL"
      ],
      "decision": "BLOCK",
      "riskScore": 90
    },
    {
      "id": "prompt_injection_block",
      "matchCategories": [
        "PROMPT_INJECTION"
      ],
      "minSeverity": "HIGH",
      "decision": "BLOCK",
      "riskScore": 88
    },
    {
      "id": "national_id_mask_or_review",
      "matchTypes": [
        "KR_RRN"
      ],
      "decision": "MASK",
      "riskScore": 65,
      "reviewThreshold": 3
    },
    {
      "id": "contact_mask",
      "matchTypes": [
        "EMAIL",
        "PHONE",
        "IP_ADDRESS"
      ],
      "decision": "MASK",
      "riskScore": 45
    },
    {
      "id": "card_mask",
      "matchTypes": [
        "CREDIT_CARD"
      ],
      "decision": "MASK",
      "riskScore": 60
    },
    {
      "id": "account_review",
      "matchTypes": [
        "BANK_ACCOUNT",
        "PASSPORT"
      ],
      "decision": "REVIEW",
      "riskScore": 55
    },
    {
      "id": "file_parse_review",
      "matchCategories": [
        "FILE_SAFETY"
      ],
      "decision": "REVIEW",
      "riskScore": 70
    },
    {
      "id": "critical_secret_block",
      "matchCategories": [
        "CREDENTIAL_SECRET",
        "CRYPTO_SECRET"
      ],
      "decision": "BLOCK",
      "riskScore": 95
    },
    {
      "id": "kr_identity_mask",
      "matchTypes": [
        "BUSINESS_REGISTRATION_NUMBER",
        "DETAILED_ADDRESS"
      ],
      "decision": "MASK",
      "riskScore": 50
    },
    {
      "id": "kr_identity_review",
      "matchTypes": [
        "ALIEN_REGISTRATION_NUMBER",
        "DRIVER_LICENSE_NUMBER",
        "CORPORATE_REGISTRATION_NUMBER",
        "DATE_OF_BIRTH"
      ],
      "decision": "REVIEW",
      "riskScore": 55
    },
    {
      "id": "wallet_informational",
      "matchTypes": [
        "ETHEREUM_ADDRESS",
        "BITCOIN_ADDRESS",
        "XRPL_ADDRESS"
      ],
      "decision": "ALLOW",
      "riskScore": 20
    },
    {
      "id": "financial_review",
      "matchTypes": [
        "IBAN",
        "SWIFT_BIC",
        "US_ROUTING_NUMBER_CANDIDATE",
        "XRPL_DESTINATION_TAG",
        "EXCHANGE_API_KEY"
      ],
      "decision": "REVIEW",
      "riskScore": 55
    },
    {
      "id": "confidential_review",
      "matchCategories": [
        "CONFIDENTIAL_DOCUMENT",
        "HIDDEN_DOCUMENT_INFO"
      ],
      "decision": "REVIEW",
      "riskScore": 70
    }
  ]
}